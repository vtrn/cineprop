/**
 * Миграция v6: Расширение таблицы Prop для Asset Manager.
 */

ALTER TABLE Prop ADD COLUMN category TEXT NOT NULL DEFAULT 'Прочее';
ALTER TABLE Prop ADD COLUMN propType TEXT NOT NULL DEFAULT 'Обстановочный';
ALTER TABLE Prop ADD COLUMN note TEXT;
ALTER TABLE Prop ADD COLUMN photoPath TEXT;
ALTER TABLE Prop ADD COLUMN isCrossCutting INTEGER NOT NULL DEFAULT 0;
ALTER TABLE Prop ADD COLUMN quantity INTEGER NOT NULL DEFAULT 1;
ALTER TABLE Prop ADD COLUMN actorId INTEGER REFERENCES Actor(id) ON DELETE SET NULL;
