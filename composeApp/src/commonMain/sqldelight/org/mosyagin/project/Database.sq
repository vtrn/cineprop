-- ТАБЛИЦА ПРОЕКТОВ
CREATE TABLE Project (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    director TEXT NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isRemote INTEGER NOT NULL DEFAULT 0,
    created_by TEXT
);

insertProject:
INSERT INTO Project(id, name, director, updatedAt, isRemote, created_by) VALUES (?, ?, ?, ?, ?, ?);

upsertProject:
INSERT OR REPLACE INTO Project(id, name, director, updatedAt, isRemote, created_by) VALUES (?, ?, ?, ?, ?, ?);

getAllProjects:
SELECT * FROM Project;

deleteProject:
DELETE FROM Project WHERE id = ?;

updateProject:
UPDATE Project SET name = ?, director = ?, updatedAt = ? WHERE id = ?;

markProjectAsRemote:
UPDATE Project SET isRemote = 1 WHERE id = ?;

getProjectById:
SELECT * FROM Project WHERE id = ?;

getProjectsByIds:
SELECT * FROM Project WHERE id IN ?;


-- ТАБЛИЦА ФАЙЛОВ СЦЕНАРИЕВ
CREATE TABLE ScriptFile (
    id TEXT PRIMARY KEY,
    project_id TEXT NOT NULL,
    seriesNumber INTEGER NOT NULL DEFAULT 1,
    title TEXT NOT NULL,
    filePath TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    previousVersionId TEXT,
    revisionColor TEXT DEFAULT 'White',
    uploadedBy TEXT,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(project_id) REFERENCES Project(id) ON DELETE CASCADE,
    FOREIGN KEY(previousVersionId) REFERENCES ScriptFile(id) ON DELETE SET NULL
);

upsertScriptFile:
INSERT OR REPLACE INTO ScriptFile(id, project_id, seriesNumber, title, filePath, createdAt, previousVersionId, revisionColor, uploadedBy, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertScriptFile:
INSERT INTO ScriptFile(id, project_id, seriesNumber, title, filePath, createdAt, previousVersionId, revisionColor, uploadedBy, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getScriptsForProject:
SELECT * FROM ScriptFile WHERE project_id = ? ORDER BY createdAt ASC;

getLatestScriptVersion:
SELECT * FROM ScriptFile
WHERE project_id = ? AND seriesNumber = ?
ORDER BY createdAt DESC LIMIT 1;

deleteScriptFile:
DELETE FROM ScriptFile WHERE id = ?;

updateScriptFileTitle:
UPDATE ScriptFile SET title = ?, updatedAt = ? WHERE id = ?;

getScriptFileById:
SELECT * FROM ScriptFile WHERE id = ?;

getScriptFilesByIds:
SELECT * FROM ScriptFile WHERE id IN ?;


-- ТАБЛИЦА СЦЕН
CREATE TABLE SceneUserData (
    id TEXT PRIMARY KEY,
    project_id TEXT NOT NULL,
    seriesNumber INTEGER NOT NULL,
    sceneNumber TEXT NOT NULL,
    location TEXT NOT NULL,
    isInterior INTEGER NOT NULL,
    timeOfDay TEXT NOT NULL,
    notes TEXT,
    needsReview INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDecrypted INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY(project_id) REFERENCES Project(id) ON DELETE CASCADE
);

-- ТАБЛИЦА ВЕРСИЙ СЦЕН
CREATE TABLE SceneVersion (
    id TEXT PRIMARY KEY,
    scriptFileId TEXT NOT NULL,
    sceneUserDataId TEXT NOT NULL,
    content TEXT NOT NULL,
    contentHash TEXT NOT NULL,
    positionIndex INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDecrypted INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY(scriptFileId) REFERENCES ScriptFile(id) ON DELETE CASCADE,
    FOREIGN KEY(sceneUserDataId) REFERENCES SceneUserData(id) ON DELETE CASCADE
);

upsertSceneUserData:
INSERT OR REPLACE INTO SceneUserData(id, project_id, seriesNumber, sceneNumber, location, isInterior, timeOfDay, notes, needsReview, updatedAt, isDecrypted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSceneUserData:
INSERT INTO SceneUserData(id, project_id, seriesNumber, sceneNumber, location, isInterior, timeOfDay, notes, needsReview, updatedAt, isDecrypted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSceneUserDataReviewStatus:
UPDATE SceneUserData SET needsReview = ?, updatedAt = ? WHERE id = ?;

updateSceneUserDataHeader:
UPDATE SceneUserData SET location = ?, isInterior = ?, timeOfDay = ?, updatedAt = ? WHERE id = ?;

upsertSceneVersion:
INSERT OR REPLACE INTO SceneVersion(id, scriptFileId, sceneUserDataId, content, contentHash, positionIndex, updatedAt, isDecrypted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertSceneVersion:
INSERT INTO SceneVersion(id, scriptFileId, sceneUserDataId, content, contentHash, positionIndex, updatedAt, isDecrypted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getLatestScenesForProject:
SELECT ud.*, v.content, v.contentHash, v.scriptFileId,
       (SELECT COUNT(*) FROM Prop WHERE sceneUserDataId = ud.id AND orphaned = 1) > 0 AS hasOrphanedProps,
       sf.createdAt AS scriptCreatedAt,
       (SELECT COUNT(*) FROM SceneVersion WHERE sceneUserDataId = ud.id) AS versionCount
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
JOIN ScriptFile sf ON v.scriptFileId = sf.id
WHERE ud.project_id = :projectId
  AND v.scriptFileId = (
      SELECT id FROM ScriptFile
      WHERE project_id = :projectId AND seriesNumber = CAST(ud.seriesNumber AS INTEGER)
      ORDER BY createdAt DESC LIMIT 1
  )
ORDER BY CAST(ud.seriesNumber AS INTEGER) ASC, v.positionIndex ASC;

getSceneById:
SELECT ud.*, v.content, v.contentHash
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
WHERE ud.id = ? AND v.scriptFileId = ?;

getSceneUserDataById:
SELECT * FROM SceneUserData WHERE id = ?;

getSceneUserDataByIds:
SELECT * FROM SceneUserData WHERE id IN ?;

getSceneUserDataBySeriesAndNumber:
SELECT * FROM SceneUserData WHERE project_id = ? AND seriesNumber = ? AND sceneNumber = ? LIMIT 1;

deleteSceneUserData:
DELETE FROM SceneUserData WHERE id = ?;

deleteSceneVersion:
DELETE FROM SceneVersion WHERE id = ?;

deleteScenesByScriptFile:
DELETE FROM SceneVersion WHERE scriptFileId = ?;

getSceneVersionsForUserData:
SELECT * FROM SceneVersion WHERE sceneUserDataId = ? ORDER BY id DESC;

getSceneVersionsByIds:
SELECT * FROM SceneVersion WHERE id IN ?;

getScenesBySeries:
SELECT ud.*, v.content, v.contentHash
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
WHERE ud.project_id = ? AND ud.seriesNumber = ? AND v.scriptFileId = ?
ORDER BY v.positionIndex ASC;

getScenesByProject:
SELECT ud.*, v.content, v.contentHash
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
WHERE ud.project_id = ? AND v.scriptFileId = ?
ORDER BY v.positionIndex ASC;

getScenesByActor:
SELECT ud.*, v.content, v.contentHash
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
JOIN SceneActor sa ON ud.id = sa.sceneUserDataId
WHERE sa.actorId = ? AND v.scriptFileId = ?
ORDER BY CAST(ud.seriesNumber AS INTEGER) ASC, CAST(ud.sceneNumber AS INTEGER) ASC;

getLocationsByActor:
SELECT DISTINCT ud.location FROM SceneUserData ud
JOIN SceneActor sa ON ud.id = sa.sceneUserDataId
WHERE sa.actorId = ?
ORDER BY ud.location ASC;


-- ТАБЛИЦА ПЕРСОНАЖЕЙ
CREATE TABLE Actor (
    id TEXT PRIMARY KEY,
    project_id TEXT NOT NULL,
    name TEXT NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(project_id) REFERENCES Project(id) ON DELETE CASCADE,
    UNIQUE(project_id, name)
);

insertActor:
INSERT OR IGNORE INTO Actor(id, project_id, name, updatedAt) VALUES (?, ?, ?, ?);

upsertActor:
INSERT OR REPLACE INTO Actor(id, project_id, name, updatedAt) VALUES (?, ?, ?, ?);

getActorByName:
SELECT * FROM Actor WHERE project_id = ? AND name = ? LIMIT 1;

getActorsByProject:
SELECT * FROM Actor WHERE project_id = ? ORDER BY name ASC;

getActorsByIds:
SELECT * FROM Actor WHERE id IN ?;

deleteActor:
DELETE FROM Actor WHERE id = ?;


-- СВЯЗЬ СЦЕНА-АКТЕР
CREATE TABLE SceneActor (
    sceneUserDataId TEXT NOT NULL,
    actorId TEXT NOT NULL,
    PRIMARY KEY(sceneUserDataId, actorId),
    FOREIGN KEY(sceneUserDataId) REFERENCES SceneUserData(id) ON DELETE CASCADE,
    FOREIGN KEY(actorId) REFERENCES Actor(id) ON DELETE CASCADE
);

linkActorToScene:
INSERT OR REPLACE INTO SceneActor(sceneUserDataId, actorId) VALUES (?, ?);

upsertSceneActor:
INSERT OR REPLACE INTO SceneActor(sceneUserDataId, actorId) VALUES (?, ?);

clearSceneActors:
DELETE FROM SceneActor WHERE sceneUserDataId = ?;

deleteSceneActor:
DELETE FROM SceneActor WHERE sceneUserDataId = ? AND actorId = ?;

getActorsForScene:
SELECT a.* FROM Actor a
JOIN SceneActor sa ON a.id = sa.actorId
WHERE sa.sceneUserDataId = ?;


-- ТАБЛИЦА РЕКВИЗИТА
CREATE TABLE Prop (
    id TEXT PRIMARY KEY,
    sceneUserDataId TEXT NOT NULL,
    name TEXT NOT NULL,
    anchor TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'Найти',
    category TEXT NOT NULL DEFAULT 'Прочее',
    propType TEXT NOT NULL DEFAULT 'Обстановочный',
    note TEXT,
    photoPath TEXT,
    isCrossCutting INTEGER NOT NULL DEFAULT 0,
    quantity INTEGER NOT NULL DEFAULT 1,
    actorId TEXT,
    startOffset INTEGER NOT NULL,
    endOffset INTEGER NOT NULL,
    orphaned INTEGER NOT NULL DEFAULT 0,
    groupId TEXT,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    isDecrypted INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY(sceneUserDataId) REFERENCES SceneUserData(id) ON DELETE CASCADE,
    FOREIGN KEY(actorId) REFERENCES Actor(id) ON DELETE SET NULL,
    FOREIGN KEY(groupId) REFERENCES Prop(id) ON DELETE SET NULL
);

insertFullProp:
INSERT INTO Prop(id, sceneUserDataId, name, anchor, status, category, propType, note, photoPath, isCrossCutting, quantity, actorId, startOffset, endOffset, orphaned, groupId, updatedAt, isDecrypted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertProp:
INSERT OR REPLACE INTO Prop(id, sceneUserDataId, name, anchor, status, category, propType, note, photoPath, isCrossCutting, quantity, actorId, startOffset, endOffset, orphaned, groupId, updatedAt, isDecrypted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getPropsForScene:
SELECT * FROM Prop WHERE sceneUserDataId = ? ORDER BY id DESC;

getPropsByProject:
SELECT p.*, ud.seriesNumber, ud.sceneNumber FROM Prop p JOIN SceneUserData ud ON p.sceneUserDataId = ud.id WHERE ud.project_id = ? ORDER BY p.status ASC, p.name ASC;

deleteProp:
DELETE FROM Prop WHERE id = ?;

updatePropStatus:
UPDATE Prop SET status = ?, updatedAt = ? WHERE id = ?;

getPropsByIds:
SELECT * FROM Prop WHERE id IN ?;

updatePropCategory:
UPDATE Prop SET category = ?, updatedAt = ? WHERE id = ?;

updatePropQuantity:
UPDATE Prop SET quantity = ?, updatedAt = ? WHERE id = ?;

updatePropCrossCutting:
UPDATE Prop SET isCrossCutting = ?, updatedAt = ? WHERE id = ?;

updatePropActor:
UPDATE Prop SET actorId = ?, updatedAt = ? WHERE id = ?;

updatePropType:
UPDATE Prop SET propType = ?, updatedAt = ? WHERE id = ?;

updatePropGroupId:
UPDATE Prop SET groupId = ?, updatedAt = ? WHERE id = ?;


-- ЗАПРОСЫ ДЛЯ KEYMANAGER
getUndecryptedScenes:
SELECT * FROM SceneUserData WHERE isDecrypted = 0;

getUndecryptedVersions:
SELECT * FROM SceneVersion WHERE isDecrypted = 0;

getUndecryptedProps:
SELECT * FROM Prop WHERE isDecrypted = 0;

updateSceneNotesAfterDecryption:
UPDATE SceneUserData SET notes = ?, isDecrypted = 1 WHERE id = ?;

updateVersionContentAfterDecryption:
UPDATE SceneVersion SET content = ?, isDecrypted = 1 WHERE id = ?;

updatePropNoteAfterDecryption:
UPDATE Prop SET note = ?, isDecrypted = 1 WHERE id = ?;

updatePropNote: -- Обычный апдейт из репозитория
UPDATE Prop SET note = ?, updatedAt = ? WHERE id = ?;


-- ТАБЛИЦА НАСТРОЕК
CREATE TABLE AppSettings (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);

getSetting:
SELECT value FROM AppSettings WHERE key = ?;

upsertSetting:
INSERT OR REPLACE INTO AppSettings (key, value) VALUES (?, ?);


-- ТАБЛИЦА ФАЙЛОВ КПП
CREATE TABLE KppFile (
    id TEXT PRIMARY KEY,
    project_id TEXT NOT NULL,
    fileName TEXT NOT NULL,
    filePath TEXT NOT NULL,
    version INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(project_id) REFERENCES Project(id) ON DELETE CASCADE
);

insertKppFile:
INSERT INTO KppFile(id, project_id, fileName, filePath, version, updatedAt) VALUES (?, ?, ?, ?, ?, ?);

upsertKppFile:
INSERT OR REPLACE INTO KppFile(id, project_id, fileName, filePath, version, updatedAt) VALUES (?, ?, ?, ?, ?, ?);

getKppFileById:
SELECT * FROM KppFile WHERE id = ?;

getKppFilesByProject:
SELECT * FROM KppFile WHERE project_id = ? ORDER BY version DESC;

getKppFilesByIds:
SELECT * FROM KppFile WHERE id IN ?;

deleteKppFile:
DELETE FROM KppFile WHERE id = ?;


-- ТАБЛИЦА СМЕНА
CREATE TABLE Shift (
    id TEXT PRIMARY KEY,
    project_id TEXT NOT NULL,
    shiftNumber INTEGER NOT NULL,
    date TEXT NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(project_id) REFERENCES Project(id) ON DELETE CASCADE
);

insertShift:
INSERT INTO Shift(id, project_id, shiftNumber, date, updatedAt) VALUES (?, ?, ?, ?, ?);

upsertShift:
INSERT OR REPLACE INTO Shift(id, project_id, shiftNumber, date, updatedAt) VALUES (?, ?, ?, ?, ?);

getShiftById:
SELECT * FROM Shift WHERE id = ?;

getShiftsByProject:
SELECT * FROM Shift WHERE project_id = ? ORDER BY shiftNumber ASC;

getShiftsByIds:
SELECT * FROM Shift WHERE id IN ?;

deleteShift:
DELETE FROM Shift WHERE id = ?;

getShiftByNumber:
SELECT * FROM Shift WHERE project_id = ? AND shiftNumber = ? LIMIT 1;


-- СВЯЗЬ СМЕНА-СЦЕНА
CREATE TABLE ShiftScene (
    shiftId TEXT NOT NULL,
    sceneUserDataId TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(shiftId, sceneUserDataId),
    FOREIGN KEY(shiftId) REFERENCES Shift(id) ON DELETE CASCADE,
    FOREIGN KEY(sceneUserDataId) REFERENCES SceneUserData(id) ON DELETE CASCADE
);

insertShiftScene:
INSERT INTO ShiftScene(shiftId, sceneUserDataId, position) VALUES (?, ?, ?);

upsertShiftScene:
INSERT OR REPLACE INTO ShiftScene(shiftId, sceneUserDataId, position) VALUES (?, ?, ?);

linkShiftToScene:
INSERT INTO ShiftScene(shiftId, sceneUserDataId, position) VALUES (?, ?, ?);

getScenesForShift:
SELECT ud.*, v.content, v.contentHash, v.scriptFileId
FROM SceneUserData ud
JOIN ShiftScene ss ON ud.id = ss.sceneUserDataId
LEFT JOIN SceneVersion v ON v.id = (
    SELECT sv.id
    FROM SceneVersion sv
    JOIN ScriptFile sf ON sv.scriptFileId = sf.id
    WHERE sv.sceneUserDataId = ud.id
    ORDER BY sf.createdAt DESC
    LIMIT 1
)
WHERE ss.shiftId = ?
ORDER BY ss.position ASC;

getShiftScenesByShiftId:
SELECT * FROM ShiftScene WHERE shiftId = ?;

deleteShiftScene:
DELETE FROM ShiftScene WHERE shiftId = ? AND sceneUserDataId = ?;


-- УЧАСТНИКИ ПРОЕКТА
CREATE TABLE ProjectMember (
    id TEXT PRIMARY KEY,
    project_id TEXT NOT NULL,
    user_id TEXT,
    email TEXT NOT NULL,
    role TEXT NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    wrapped_master_key TEXT,
    FOREIGN KEY(project_id) REFERENCES Project(id) ON DELETE CASCADE,
    UNIQUE(project_id, email)
);

upsertProjectMember:
INSERT OR REPLACE INTO ProjectMember(id, project_id, user_id, email, role, updatedAt, wrapped_master_key)
VALUES (?, ?, ?, ?, ?, ?, ?);

getProjectMemberById:
SELECT * FROM ProjectMember WHERE id = ?;

getProjectMembersByIds:
SELECT * FROM ProjectMember WHERE id IN ?;

getMembersByProject:
SELECT * FROM ProjectMember WHERE project_id = ? ORDER BY role ASC, email ASC;

deleteProjectMember:
DELETE FROM ProjectMember WHERE id = ?;

getWrappedKeys:
SELECT project_id, wrapped_master_key FROM ProjectMember WHERE wrapped_master_key IS NOT NULL;


-- ОЧЕРЕДЬ СИНХРОНИЗАЦИИ
CREATE TABLE SyncQueue (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    operation TEXT NOT NULL,
    tableName TEXT NOT NULL,
    recordId TEXT NOT NULL,
    project_id TEXT,
    dataJson TEXT,
    updatedAt INTEGER NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0,
    UNIQUE(tableName, recordId) ON CONFLICT REPLACE
);

enqueue:
INSERT INTO SyncQueue(operation, tableName, recordId, project_id, dataJson, updatedAt, synced)
VALUES (?, ?, ?, ?, ?, ?, 0);

getPending:
SELECT * FROM SyncQueue WHERE synced = 0 ORDER BY updatedAt ASC;

markSynced:
UPDATE SyncQueue SET synced = 1 WHERE id IN ?;

lastInsertRowId:
SELECT last_insert_rowid();
