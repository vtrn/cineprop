/**
 * Описание структуры базы данных и SQL-запросов (SQLDelight).
 */

-- ТАБЛИЦА ПРОЕКТОВ
CREATE TABLE Project (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    director TEXT NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0 -- Для синхронизации
);

-- Запросы для проектов
insertProject:
INSERT INTO Project(name, director, updatedAt) VALUES (?, ?, ?);

upsertProject:
INSERT OR REPLACE INTO Project(id, name, director, updatedAt) VALUES (?, ?, ?, ?);

getAllProjects:
SELECT * FROM Project;

deleteProject:
DELETE FROM Project WHERE id = ?;

updateProject:
UPDATE Project SET name = ?, director = ?, updatedAt = ? WHERE id = ?;

getProjectById:
SELECT * FROM Project WHERE id = ?;

getProjectsByIds:
SELECT * FROM Project WHERE id IN ?;


-- ТАБЛИЦА ФАЙЛОВ СЦЕНАРИЕВ
CREATE TABLE ScriptFile (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    seriesNumber INTEGER NOT NULL DEFAULT 1,
    title TEXT NOT NULL,
    filePath TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    previousVersionId INTEGER,
    revisionColor TEXT DEFAULT 'White',
    uploadedBy TEXT,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- Для синхронизации
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE,
    FOREIGN KEY(previousVersionId) REFERENCES ScriptFile(id) ON DELETE SET NULL
);

insertScriptFile:
INSERT INTO ScriptFile(projectId, seriesNumber, title, filePath, createdAt, previousVersionId, revisionColor, uploadedBy, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertScriptFile:
INSERT OR REPLACE INTO ScriptFile(id, projectId, seriesNumber, title, filePath, createdAt, previousVersionId, revisionColor, uploadedBy, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getScriptsForProject:
SELECT * FROM ScriptFile WHERE projectId = ? ORDER BY createdAt ASC;

getLatestScriptVersion:
SELECT * FROM ScriptFile
WHERE projectId = ? AND seriesNumber = ?
ORDER BY createdAt DESC LIMIT 1;

deleteScriptFile:
DELETE FROM ScriptFile WHERE id = ?;

updateScriptFileTitle:
UPDATE ScriptFile SET title = ?, updatedAt = ? WHERE id = ?;

getScriptFileById:
SELECT * FROM ScriptFile WHERE id = ?;

getScriptFilesByIds:
SELECT * FROM ScriptFile WHERE id IN ?;


-- ТАБЛИЦА СЦЕН (Якорь для пользовательских данных)
CREATE TABLE SceneUserData (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    seriesNumber INTEGER NOT NULL,
    sceneNumber TEXT NOT NULL,
    location TEXT NOT NULL,
    isInterior INTEGER NOT NULL,
    timeOfDay TEXT NOT NULL,
    notes TEXT,
    needsReview INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- Для синхронизации
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

-- ТАБЛИЦА ВЕРСИЙ СЦЕН
CREATE TABLE SceneVersion (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    scriptFileId INTEGER NOT NULL,
    sceneUserDataId INTEGER NOT NULL,
    content TEXT NOT NULL,
    contentHash TEXT NOT NULL,
    positionIndex INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- Для синхронизации
    FOREIGN KEY(scriptFileId) REFERENCES ScriptFile(id) ON DELETE CASCADE,
    FOREIGN KEY(sceneUserDataId) REFERENCES SceneUserData(id) ON DELETE CASCADE
);

updateSceneUserDataReviewStatus:
UPDATE SceneUserData SET needsReview = ?, updatedAt = ? WHERE id = ?;

updateSceneUserDataHeader:
UPDATE SceneUserData
SET location = ?, isInterior = ?, timeOfDay = ?, updatedAt = ?
WHERE id = ?;

insertSceneUserData:
INSERT INTO SceneUserData(projectId, seriesNumber, sceneNumber, location, isInterior, timeOfDay, notes, needsReview, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertSceneUserData:
INSERT OR REPLACE INTO SceneUserData(id, projectId, seriesNumber, sceneNumber, location, isInterior, timeOfDay, notes, needsReview, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSceneVersion:
INSERT INTO SceneVersion(scriptFileId, sceneUserDataId, content, contentHash, positionIndex, updatedAt)
VALUES (?, ?, ?, ?, ?, ?);

upsertSceneVersion:
INSERT OR REPLACE INTO SceneVersion(id, scriptFileId, sceneUserDataId, content, contentHash, positionIndex, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

getScenesBySeries:
SELECT ud.*, v.content, v.contentHash
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
WHERE ud.projectId = ? AND ud.seriesNumber = ? AND v.scriptFileId = ?
ORDER BY v.positionIndex ASC;

getScenesByProject:
SELECT ud.*, v.content, v.contentHash
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
WHERE ud.projectId = ? AND v.scriptFileId = ?
ORDER BY v.positionIndex ASC;

getLatestScenesForProject:
SELECT ud.*, v.content, v.contentHash, v.scriptFileId,
       (SELECT COUNT(*) FROM Prop WHERE sceneUserDataId = ud.id AND orphaned = 1) > 0 AS hasOrphanedProps,
       sf.createdAt AS scriptCreatedAt,
       (SELECT COUNT(*) FROM SceneVersion WHERE sceneUserDataId = ud.id) AS versionCount
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
JOIN ScriptFile sf ON v.scriptFileId = sf.id
WHERE ud.projectId = :projectId
  AND v.scriptFileId = (
      SELECT id FROM ScriptFile
      WHERE projectId = :projectId AND seriesNumber = CAST(ud.seriesNumber AS INTEGER)
      ORDER BY createdAt DESC LIMIT 1
  )
ORDER BY CAST(ud.seriesNumber AS INTEGER) ASC, v.positionIndex ASC;

getSceneById:
SELECT ud.*, v.content, v.contentHash
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
WHERE ud.id = ? AND v.scriptFileId = ?;

getSceneVersionsForUserData:
SELECT * FROM SceneVersion WHERE sceneUserDataId = ? ORDER BY id DESC;

getSceneUserDataById:
SELECT * FROM SceneUserData WHERE id = ?;

getSceneUserDataByIds:
SELECT * FROM SceneUserData WHERE id IN ?;

getSceneUserDataBySeriesAndNumber:
SELECT * FROM SceneUserData WHERE projectId = ? AND seriesNumber = ? AND sceneNumber = ? LIMIT 1;

getScenesByActor:
SELECT ud.*, v.content, v.contentHash
FROM SceneUserData ud
JOIN SceneVersion v ON ud.id = v.sceneUserDataId
JOIN SceneActor sa ON ud.id = sa.sceneUserDataId
WHERE sa.actorId = ? AND v.scriptFileId = ?
ORDER BY CAST(ud.seriesNumber AS INTEGER) ASC, CAST(ud.sceneNumber AS INTEGER) ASC;

getLocationsByActor:
SELECT DISTINCT ud.location FROM SceneUserData ud
JOIN SceneActor sa ON ud.id = sa.sceneUserDataId
WHERE sa.actorId = ?
ORDER BY ud.location ASC;

deleteScenesByScriptFile:
DELETE FROM SceneVersion WHERE scriptFileId = ?;

getSceneVersionsByIds:
SELECT * FROM SceneVersion WHERE id IN ?;


-- ТАБЛИЦА ПЕРСОНАЖЕЙ
CREATE TABLE Actor (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    name TEXT NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- Для синхронизации
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE,
    UNIQUE(projectId, name)
);

insertActor:
INSERT OR IGNORE INTO Actor(projectId, name, updatedAt) VALUES (?, ?, ?);

upsertActor:
INSERT OR REPLACE INTO Actor(id, projectId, name, updatedAt) VALUES (?, ?, ?, ?);

getActorByName:
SELECT * FROM Actor WHERE projectId = ? AND name = ? LIMIT 1;

getActorsByProject:
SELECT * FROM Actor WHERE projectId = ? ORDER BY name ASC;

getActorsByIds:
SELECT * FROM Actor WHERE id IN ?;


-- СВЯЗЬ СМЕНА-СЦЕНА
CREATE TABLE SceneActor (
    sceneUserDataId INTEGER NOT NULL,
    actorId INTEGER NOT NULL,
    PRIMARY KEY(sceneUserDataId, actorId),
    FOREIGN KEY(sceneUserDataId) REFERENCES SceneUserData(id) ON DELETE CASCADE,
    FOREIGN KEY(actorId) REFERENCES Actor(id) ON DELETE CASCADE
);

linkActorToScene:
INSERT OR IGNORE INTO SceneActor(sceneUserDataId, actorId) VALUES (?, ?);

clearSceneActors:
DELETE FROM SceneActor WHERE sceneUserDataId = ?;

getActorsForScene:
SELECT a.* FROM Actor a
JOIN SceneActor sa ON a.id = sa.actorId
WHERE sa.sceneUserDataId = ?;


-- ТАБЛИЦА РЕКВИЗИТА
CREATE TABLE Prop (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sceneUserDataId INTEGER NOT NULL,
    name TEXT NOT NULL,
    anchor TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'Найти',
    category TEXT NOT NULL DEFAULT 'Прочее',
    propType TEXT NOT NULL DEFAULT 'Обстановочный',
    note TEXT,
    photoPath TEXT,
    isCrossCutting INTEGER NOT NULL DEFAULT 0,
    quantity INTEGER NOT NULL DEFAULT 1,
    actorId INTEGER,
    startOffset INTEGER NOT NULL,
    endOffset INTEGER NOT NULL,
    orphaned INTEGER NOT NULL DEFAULT 0,
    groupId INTEGER,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- Для синхронизации
    FOREIGN KEY(sceneUserDataId) REFERENCES SceneUserData(id) ON DELETE CASCADE,
    FOREIGN KEY(actorId) REFERENCES Actor(id) ON DELETE SET NULL,
    FOREIGN KEY(groupId) REFERENCES Prop(id) ON DELETE SET NULL
);

insertFullProp:
INSERT INTO Prop(
    sceneUserDataId, name, anchor, status, category, propType,
    note, photoPath, isCrossCutting, quantity, actorId,
    startOffset, endOffset, orphaned, groupId, updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertProp:
INSERT OR REPLACE INTO Prop(id, sceneUserDataId, name, anchor, status, category, propType, note, photoPath, isCrossCutting, quantity, actorId, startOffset, endOffset, orphaned, groupId, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getPropsForScene:
SELECT * FROM Prop WHERE sceneUserDataId = ? ORDER BY id DESC;

getPropsByProject:
SELECT p.*, ud.seriesNumber, ud.sceneNumber
FROM Prop p
JOIN SceneUserData ud ON p.sceneUserDataId = ud.id
WHERE ud.projectId = ?
ORDER BY p.status ASC, p.name ASC;

getPropsWithShiftByProject:
SELECT p.*, ud.seriesNumber, ud.sceneNumber, s.shiftNumber, s.date AS shiftDate, s.id AS shiftId
FROM Prop p
JOIN SceneUserData ud ON p.sceneUserDataId = ud.id
JOIN ShiftScene ss ON ud.id = ss.sceneUserDataId
JOIN Shift s ON ss.shiftId = s.id
WHERE ud.projectId = ?
ORDER BY s.shiftNumber ASC, ss.position ASC, p.name ASC;

deleteProp:
DELETE FROM Prop WHERE id = ?;

updatePropStatus:
UPDATE Prop SET status = ?, updatedAt = ? WHERE id = ?;

updatePropOrphanedStatus:
UPDATE Prop SET orphaned = ?, updatedAt = ? WHERE id = ?;

updatePropCategory:
UPDATE Prop SET category = ?, updatedAt = ? WHERE id = ?;

updatePropNote:
UPDATE Prop SET note = ?, updatedAt = ? WHERE id = ?;

updatePropQuantity:
UPDATE Prop SET quantity = ?, updatedAt = ? WHERE id = ?;

updatePropPhoto:
UPDATE Prop SET photoPath = ?, updatedAt = ? WHERE id = ?;

updatePropCrossCutting:
UPDATE Prop SET isCrossCutting = ?, updatedAt = ? WHERE id = ?;

updatePropActor:
UPDATE Prop SET actorId = ?, updatedAt = ? WHERE id = ?;

updatePropType:
UPDATE Prop SET propType = ?, updatedAt = ? WHERE id = ?;

updatePropGroupId:
UPDATE Prop SET groupId = ?, updatedAt = ? WHERE id = ?;

getPropsByIds:
SELECT * FROM Prop WHERE id IN ?;


-- ТАБЛИЦА НАСТРОЕК
CREATE TABLE AppSettings (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);

getSetting:
SELECT value FROM AppSettings WHERE key = ?;

upsertSetting:
INSERT OR REPLACE INTO AppSettings (key, value) VALUES (?, ?);

lastInsertRowId:
SELECT last_insert_rowid();


-- ТАБЛИЦА ФАЙЛОВ КПП
CREATE TABLE KppFile (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    fileName TEXT NOT NULL,
    filePath TEXT NOT NULL,
    version INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- Для синхронизации
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

insertKppFile:
INSERT INTO KppFile(projectId, fileName, filePath, version, updatedAt) VALUES (?, ?, ?, ?, ?);

getKppFilesByProject:
SELECT * FROM KppFile WHERE projectId = ? ORDER BY version DESC;


-- ТАБЛИЦА СМЕНА
CREATE TABLE Shift (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    shiftNumber INTEGER NOT NULL,
    date TEXT NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0, -- Для синхронизации
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

insertShift:
INSERT INTO Shift(projectId, shiftNumber, date, updatedAt) VALUES (?, ?, ?, ?);

getShiftsByProject:
SELECT * FROM Shift WHERE projectId = ? ORDER BY shiftNumber ASC;

getShiftByNumber:
SELECT * FROM Shift WHERE projectId = ? AND shiftNumber = ? LIMIT 1;

getShiftById:
SELECT * FROM Shift WHERE id = ?;


-- СВЯЗЬ СМЕНА-СЦЕНА
CREATE TABLE ShiftScene (
    shiftId INTEGER NOT NULL,
    sceneUserDataId INTEGER NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(shiftId, sceneUserDataId),
    FOREIGN KEY(shiftId) REFERENCES Shift(id) ON DELETE CASCADE,
    FOREIGN KEY(sceneUserDataId) REFERENCES SceneUserData(id) ON DELETE CASCADE
);

linkShiftToScene:
INSERT OR IGNORE INTO ShiftScene(shiftId, sceneUserDataId, position) VALUES (?, ?, ?);

getScenesForShift:
SELECT ud.*, v.content, v.contentHash, v.scriptFileId
FROM SceneUserData ud
JOIN ShiftScene ss ON ud.id = ss.sceneUserDataId
LEFT JOIN SceneVersion v ON v.id = (
    SELECT sv.id
    FROM SceneVersion sv
    JOIN ScriptFile sf ON sv.scriptFileId = sf.id
    WHERE sv.sceneUserDataId = ud.id
    ORDER BY sf.createdAt DESC
    LIMIT 1
)
WHERE ss.shiftId = ?
ORDER BY ss.position ASC;


-- ==========================================
-- ОЧЕРЕДЬ СИНХРОНИЗАЦИИ (Issue #2)
-- ==========================================

CREATE TABLE SyncQueue (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    operation TEXT NOT NULL,    -- 'INSERT', 'UPDATE', 'DELETE'
    tableName TEXT NOT NULL,    -- Имя таблицы
    recordId INTEGER NOT NULL,  -- Локальный ID записи
    dataJson TEXT,              -- Данные в JSON для отправки (null для DELETE)
    updatedAt INTEGER NOT NULL, -- Время создания записи в очереди
    synced INTEGER NOT NULL DEFAULT 0, -- 0 - ждет, 1 - отправлено
    UNIQUE(tableName, recordId) ON CONFLICT REPLACE -- Дедупликация: заменяем старую запись в очереди новой
);

-- Добавить запись в очередь
enqueue:
INSERT INTO SyncQueue(operation, tableName, recordId, dataJson, updatedAt, synced)
VALUES (?, ?, ?, ?, ?, 0);

-- Получить все несинхронизированные записи
getPending:
SELECT * FROM SyncQueue WHERE synced = 0 ORDER BY updatedAt ASC;

-- Пометить как синхронизированные
markSynced:
UPDATE SyncQueue SET synced = 1 WHERE id IN ?;

-- Удалить старые синхронизированные записи (опционально)
deleteSynced:
DELETE FROM SyncQueue WHERE synced = 1;

-- Проверить, есть ли ожидающие изменения для конкретной записи
isPending:
SELECT COUNT(*) FROM SyncQueue WHERE tableName = ? AND recordId = ? AND synced = 0;
