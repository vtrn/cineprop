/**
 * Описание структуры базы данных и SQL-запросов (SQLDelight).
 * Из этого файла автоматически генерируется Kotlin-код для работы с данными.
 */

-- ТАБЛИЦА ПРОЕКТОВ
CREATE TABLE Project (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    director TEXT NOT NULL
);

-- Запросы для проектов
insertProject:
INSERT INTO Project(name, director) VALUES (?, ?);

getAllProjects:
SELECT * FROM Project;

deleteProject:
DELETE FROM Project WHERE id = ?;

updateProject:
UPDATE Project SET name = ?, director = ? WHERE id = ?;

getProjectById:
SELECT * FROM Project WHERE id = ?;


-- ТАБЛИЦА ФАЙЛОВ СЦЕНАРИЕВ
CREATE TABLE ScriptFile (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    title TEXT NOT NULL,      -- Например, "Серия 1"
    filePath TEXT NOT NULL,   -- Путь к файлу
    createdAt INTEGER NOT NULL,
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

insertScriptFile:
INSERT INTO ScriptFile(projectId, title, filePath, createdAt)
VALUES (?, ?, ?, ?);

getScriptsForProject:
SELECT * FROM ScriptFile WHERE projectId = ? ORDER BY createdAt ASC;

deleteScriptFile:
DELETE FROM ScriptFile WHERE id = ?;

updateScriptFileTitle:
UPDATE ScriptFile SET title = ? WHERE id = ?;

getScriptFileById:
SELECT * FROM ScriptFile WHERE id = ?;


-- ТАБЛИЦА СЦЕН
CREATE TABLE Scene (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    scriptFileId INTEGER,        -- Ссылка на файл сценария, из которого спарсена сцена
    seriesNumber TEXT NOT NULL,  -- Номер серии (из парсера)
    sceneNumber TEXT NOT NULL,   -- Номер сцены (из парсера)
    location TEXT NOT NULL,      -- Объект (ИНТ. КУХНЯ)
    isInterior INTEGER NOT NULL, -- 1 для ИНТ, 0 для НАТ
    timeOfDay TEXT NOT NULL,    -- ДЕНЬ / НОЧЬ
    content TEXT NOT NULL,       -- Весь текст сцены
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE,
    FOREIGN KEY(scriptFileId) REFERENCES ScriptFile(id) ON DELETE CASCADE
);

insertScene:
INSERT INTO Scene(projectId, scriptFileId, seriesNumber, sceneNumber, location, isInterior, timeOfDay, content)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getScenesBySeries:
SELECT * FROM Scene
WHERE projectId = ? AND seriesNumber = ?
ORDER BY CAST(sceneNumber AS INTEGER) ASC, sceneNumber ASC;

getScenesByProject:
SELECT * FROM Scene
WHERE projectId = ?
ORDER BY CAST(seriesNumber AS INTEGER) ASC, seriesNumber ASC, CAST(sceneNumber AS INTEGER) ASC, sceneNumber ASC;

getSceneById:
SELECT * FROM Scene WHERE id = ?;

getSceneIdBySeriesAndNumber:
SELECT id FROM Scene WHERE projectId = ? AND seriesNumber = ? AND sceneNumber = ? LIMIT 1;

deleteScenesByScriptFile:
DELETE FROM Scene WHERE scriptFileId = ?;


-- ТАБЛИЦА ПЕРСОНАЖЕЙ
CREATE TABLE Actor (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    name TEXT NOT NULL,
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

insertActor:
INSERT OR IGNORE INTO Actor(projectId, name) VALUES (?, ?);

getActorByName:
SELECT * FROM Actor WHERE projectId = ? AND name = ? LIMIT 1;


-- СВЯЗЬ СЦЕНА-АКТЕР (Многие-ко-многим)
CREATE TABLE SceneActor (
    sceneId INTEGER NOT NULL,
    actorId INTEGER NOT NULL,
    PRIMARY KEY(sceneId, actorId),
    FOREIGN KEY(sceneId) REFERENCES Scene(id) ON DELETE CASCADE,
    FOREIGN KEY(actorId) REFERENCES Actor(id) ON DELETE CASCADE
);

linkActorToScene:
INSERT OR IGNORE INTO SceneActor(sceneId, actorId) VALUES (?, ?);

getActorsForScene:
SELECT a.* FROM Actor a
JOIN SceneActor sa ON a.id = sa.actorId
WHERE sa.sceneId = ?;


-- ТАБЛИЦА РЕКВИЗИТА
CREATE TABLE Prop (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sceneId INTEGER NOT NULL,
    name TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'Найти',
    startOffset INTEGER NOT NULL,
    endOffset INTEGER NOT NULL,
    FOREIGN KEY(sceneId) REFERENCES Scene(id) ON DELETE CASCADE
);

insertProp:
INSERT INTO Prop(sceneId, name, status, startOffset, endOffset) VALUES (?, ?, ?, ?, ?);

getPropsForScene:
SELECT * FROM Prop WHERE sceneId = ? ORDER BY id DESC;

deleteProp:
DELETE FROM Prop WHERE id = ?;

updatePropStatus:
UPDATE Prop SET status = ? WHERE id = ?;


-- ТАБЛИЦА ФАЙЛОВ КПП
CREATE TABLE KppFile (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    fileName TEXT NOT NULL,
    filePath TEXT NOT NULL,
    version INTEGER NOT NULL,
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

insertKppFile:
INSERT INTO KppFile(projectId, fileName, filePath, version) VALUES (?, ?, ?, ?);

getKppFilesByProject:
SELECT * FROM KppFile WHERE projectId = ? ORDER BY version DESC;


-- ТАБЛИЦА СМЕН
CREATE TABLE Shift (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    shiftNumber INTEGER NOT NULL,
    date TEXT NOT NULL,
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

insertShift:
INSERT INTO Shift(projectId, shiftNumber, date) VALUES (?, ?, ?);

getShiftsByProject:
SELECT * FROM Shift WHERE projectId = ? ORDER BY shiftNumber ASC;

getShiftByNumber:
SELECT * FROM Shift WHERE projectId = ? AND shiftNumber = ? LIMIT 1;

getShiftById:
SELECT * FROM Shift WHERE id = ?;


-- СВЯЗЬ СМЕНА-СЦЕНА
CREATE TABLE ShiftScene (
    shiftId INTEGER NOT NULL,
    sceneId INTEGER NOT NULL,
    position INTEGER NOT NULL DEFAULT 0, -- Добавили позицию для сохранения порядка из КПП
    PRIMARY KEY(shiftId, sceneId),
    FOREIGN KEY(shiftId) REFERENCES Shift(id) ON DELETE CASCADE,
    FOREIGN KEY(sceneId) REFERENCES Scene(id) ON DELETE CASCADE
);

linkShiftToScene:
INSERT OR IGNORE INTO ShiftScene(shiftId, sceneId, position) VALUES (?, ?, ?);

getScenesForShift:
SELECT s.* FROM Scene s
JOIN ShiftScene ss ON s.id = ss.sceneId
WHERE ss.shiftId = ?
ORDER BY ss.position ASC; -- Теперь сортируем строго по порядку из КПП

-- СЛУЖЕБНЫЕ ЗАПРОСЫ
lastInsertRowId:
SELECT last_insert_rowid();
