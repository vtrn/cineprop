
CREATE TABLE Project (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    director TEXT NOT NULL
);

-- Запросы к БД (они станут Kotlin-методами)
insertProject:
INSERT INTO Project(name, director) VALUES (?, ?);

getAllProjects:
SELECT * FROM Project;

-- Удалить конкретный проект по ID
deleteProject:
DELETE FROM Project WHERE id = ?;

-- Обновить данные проекта
updateProject:
UPDATE Project SET name = ?, director = ? WHERE id = ?;

-- Получить один проект (понадобится для редактирования)
getProjectById:
SELECT * FROM Project WHERE id = ?;


CREATE TABLE ScriptFile (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    title TEXT NOT NULL,      -- Например, "Серия 1"
    filePath TEXT NOT NULL,   -- Путь к файлу в памяти телефона
    createdAt INTEGER NOT NULL,
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

-- Запросы
insertScriptFile:
INSERT INTO ScriptFile(projectId, title, filePath, createdAt)
VALUES (?, ?, ?, ?);

getScriptsForProject:
SELECT * FROM ScriptFile WHERE projectId = ? ORDER BY createdAt ASC;

deleteScriptFile:
DELETE FROM ScriptFile WHERE id = ?;

-- Таблица СЦЕН с номером серии
CREATE TABLE Scene (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    seriesNumber INTEGER NOT NULL,  -- Добавили это
    sceneNumber INTEGER NOT NULL,   -- Номер сцены
    location TEXT NOT NULL,
    isInterior INTEGER NOT NULL,
    timeOfDay TEXT NOT NULL,
    content TEXT NOT NULL,
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

-- Таблица для ПЕРСОНАЖЕЙ (Актеров)
CREATE TABLE Actor (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    projectId INTEGER NOT NULL,
    name TEXT NOT NULL,             -- "НАСТЯ"
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);

-- Таблица-связка: КТО в какой СЦЕНЕ (многие-ко-многим)
CREATE TABLE SceneActor (
    sceneId INTEGER NOT NULL,
    actorId INTEGER NOT NULL,
    PRIMARY KEY(sceneId, actorId),
    FOREIGN KEY(sceneId) REFERENCES Scene(id) ON DELETE CASCADE,
    FOREIGN KEY(actorId) REFERENCES Actor(id) ON DELETE CASCADE
);

-- Запрос на вставку с учетом серии
insertScene:
INSERT INTO Scene(projectId, seriesNumber, sceneNumber, location, isInterior, timeOfDay, content)
VALUES (?, ?, ?, ?, ?, ?, ?);


-- Запрос для получения сцен КОНКРЕТНОЙ серии
getScenesBySeries:
SELECT * FROM Scene WHERE projectId = ? AND seriesNumber = ? ORDER BY sceneNumber ASC;

-- Получить ID последней вставленной строки (нужно для связки с актерами)
lastInsertRowId:
SELECT last_insert_rowid();

insertActor:
INSERT OR IGNORE INTO Actor(projectId, name) VALUES (?, ?);

getActorByName:
SELECT * FROM Actor WHERE projectId = ? AND name = ? LIMIT 1;

linkActorToScene:
INSERT OR IGNORE INTO SceneActor(sceneId, actorId) VALUES (?, ?);

-- Запрос для получения сцен конкретного проекта (для общего списка)
getScenesByProject:
SELECT * FROM Scene WHERE projectId = ? ORDER BY seriesNumber ASC, sceneNumber ASC;

getSceneById:
SELECT * FROM Scene WHERE id = ?;

getActorsForScene:
SELECT a.* FROM Actor a
JOIN SceneActor sa ON a.id = sa.actorId
WHERE sa.sceneId = ?;

-- Таблица РЕКВИЗИТ
CREATE TABLE Prop (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sceneId INTEGER NOT NULL,
    name TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'Найти', -- Статусы: Найти, Готово, В кадре
    startOffset INTEGER NOT NULL, -- Начало слова в тексте
    endOffset INTEGER NOT NULL,   -- Конец слова
    FOREIGN KEY(sceneId) REFERENCES Scene(id) ON DELETE CASCADE
);

-- Запросы для реквизита
insertProp:
INSERT INTO Prop(sceneId, name, status, startOffset, endOffset) VALUES (?, ?, ?, ?, ?);

getPropsForScene:
SELECT * FROM Prop WHERE sceneId = ? ORDER BY id DESC;

deleteProp:
DELETE FROM Prop WHERE id = ?;

updatePropStatus:
UPDATE Prop SET status = ? WHERE id = ?;