CREATE TABLE ActivityLog (
    id TEXT PRIMARY KEY,
    projectId TEXT NOT NULL,
    userId TEXT NOT NULL,
    userName TEXT NOT NULL,
    type TEXT NOT NULL, -- SCENARIO, KPP, PROP, PHOTO
    action TEXT NOT NULL, -- ADDED, UPDATED, DELETED, UPLOADED
    entityId TEXT, -- ID объекта для перехода
    encryptedEntityName TEXT, -- Зашифрованное имя объекта
    encryptedDescription TEXT, -- Зашифрованное описание
    encryptedMetadata TEXT, -- Зашифрованный JSON с диффами
    createdAt INTEGER NOT NULL,
    isDecrypted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(projectId) REFERENCES Project(id) ON DELETE CASCADE
);
